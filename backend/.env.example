# Copy to .env and adjust. Never commit real secrets.

# Server
PORT=4000
NODE_ENV=development

# SQLite path (relative to process cwd when starting the backend, usually backend/)
DB_PATH=./data/cbt.sqlite

# JWT signing (use a long random string in production)
JWT_SECRET=change_me_in_production

# URL shown in startup logs (optional). Used in verification/reset email links.
APP_BASE_URL=http://localhost:5173

# Behind a reverse proxy or PaaS (nginx, Railway, Fly): trust X-Forwarded-For for client IP (rate limits, logs).
# TRUST_PROXY=1

# Optional: restrict browser CORS to listed origins (comma-separated). Leave unset for open CORS (typical local dev).
# CORS_ALLOWED_ORIGINS=https://your-app.example.com,https://www.your-app.example.com

# Optional: serve production Vite build from this Node process (path to frontend/dist).
# Example when cwd is backend/: FRONTEND_DIST=../frontend/dist
# FRONTEND_DIST=

# --- Optional: SMTP (when SMTP_HOST + MAIL_FROM are set, verification/reset emails are sent and API no longer returns raw tokens) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="SabiScholar CBT <noreply@example.com>"

# --- Optional: create or promote an admin on startup (local dev) ---
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose_a_strong_password
# BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# In production, bootstrap is ignored unless explicitly allowed:
# ALLOW_BOOTSTRAP_ADMIN=1
